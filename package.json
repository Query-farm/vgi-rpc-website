{
  "name": "vgi-rpc-website",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "diagrams": "mkdir -p public/diagrams && d2 --layout=elk src/diagrams/transport-overview.d2 public/diagrams/transport-overview.svg",
    "dev": "npm run diagrams && astro dev",
    "build": "npm run diagrams && astro build && node scripts/test-social-metadata.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "test": "python3 -m unittest discover -s benchmarks/tests -p 'test_*.py' && python3 benchmarks/run.py validate",
    "test:metadata": "node scripts/test-social-metadata.mjs",
    "benchmark:verify": "python3 benchmarks/run.py verify",
    "benchmark:quick": "python3 benchmarks/run.py quick",
    "benchmark:full": "python3 benchmarks/run.py full",
    "benchmark:publish": "python3 benchmarks/run.py publish",
    "og": "node scripts/generate-og-images.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@iconify-json/simple-icons": "^1.2.98",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "satori": "^0.33.5"
  }
}
