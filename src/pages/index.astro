---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import BuiltWith from '../components/BuiltWith.astro';
import WhatIs from '../components/WhatIs.astro';
import WhyVgiRpc from '../components/WhyVgiRpc.astro';
import TransportOverview from '../components/TransportOverview.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import BenchmarkCharts from '../components/BenchmarkCharts.astro';
import LanguageCards from '../components/LanguageCards.astro';
import CapabilityMatrix from '../components/CapabilityMatrix.astro';
import SimpleExample from '../components/SimpleExample.astro';
import GetStarted from '../components/GetStarted.astro';

const description = 'Transport-agnostic RPC built on Apache Arrow IPC serialization, with interoperable implementations for Python, TypeScript, Go, Rust, Java, C#, and C++.';
const jsonLd = {
  '@type': 'SoftwareApplication',
  '@id': 'https://vgi-rpc.query.farm/#software',
  name: 'vgi-rpc',
  url: 'https://vgi-rpc.query.farm/',
  image: 'https://vgi-rpc.query.farm/og/home.png',
  description,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux, macOS, Windows',
  softwareVersion: 'Wire protocol 1',
  featureList: [
    'Apache Arrow IPC serialization',
    'Subprocess, Unix socket, TCP, HTTP, Iroh/QUIC, and shared-memory transports',
    'Python, TypeScript, Go, Rust, Java, C#, and C++ implementations',
    'Unary, producer-stream, and bidirectional exchange calls',
  ],
};
---

<BaseLayout
  title="vgi-rpc — Transport-agnostic RPC on Apache Arrow"
  description={description}
  ogImage="/og/home.png"
  ogImageAlt="Query.Farm card for vgi-rpc: transport-agnostic RPC on Apache Arrow, in seven languages"
  jsonLd={jsonLd}
>
  <div class="rpc-home">
  <Hero />
  <WhatIs />
  <BuiltWith />
  <SimpleExample />
  <WhyVgiRpc />
  <TransportOverview />
  <ComparisonTable />
  <BenchmarkCharts />
  <LanguageCards />
  <CapabilityMatrix />
  <GetStarted />
  </div>
</BaseLayout>
