---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import BuiltWith from '../components/BuiltWith.astro';
import WhatIs from '../components/WhatIs.astro';
import WhyVgiRpc from '../components/WhyVgiRpc.astro';
import TransportOverview from '../components/TransportOverview.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import BenchmarkCharts from '../components/BenchmarkCharts.astro';
import LanguageCards from '../components/LanguageCards.astro';
import CapabilityMatrix from '../components/CapabilityMatrix.astro';
import SimpleExample from '../components/SimpleExample.astro';
import GetStarted from '../components/GetStarted.astro';

const description = 'Arrow-native RPC from subprocess to service. Define typed methods, exchange batches of work, and call HTTP services directly from the browser.';
const jsonLd = {
  '@type': 'SoftwareApplication',
  '@id': 'https://vgi-rpc.query.farm/#software',
  name: 'vgi-rpc',
  url: 'https://vgi-rpc.query.farm/',
  image: 'https://vgi-rpc.query.farm/og/home.png',
  description,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Linux, macOS, Windows',
  softwareVersion: 'Wire protocol 1',
  featureList: [
    'Apache Arrow IPC serialization',
    'Subprocess, Unix socket, TCP, HTTP, Iroh/QUIC, and shared-memory transports',
    'Python, TypeScript, Go, Rust, Java, C#, and C++ implementations',
    'Unary calls, producer streams, and batched exchange calls',
    'Direct browser access over HTTP',
    'Externalized HTTP stream state and optional sticky sessions',
  ],
};
---

<BaseLayout
  title="vgi-rpc — Arrow-native RPC. From subprocess to service."
  description={description}
  ogImage="/og/home.png"
  ogImageAlt="vgi-rpc by Query.Farm. Arrow-native RPC. From subprocess to service. Illustrated columnar batches and the four-band sun."
  jsonLd={jsonLd}
>
  <div class="rpc-home">
  <Hero />
  <WhatIs />
  <BuiltWith />
  <SimpleExample />
  <WhyVgiRpc />
  <TransportOverview />
  <ComparisonTable />
  <BenchmarkCharts />
  <LanguageCards />
  <CapabilityMatrix />
  <GetStarted />
  </div>
</BaseLayout>
