---
import StrataSun from './StrataSun.astro';

const year = new Date().getFullYear();

const columns: { title: string; links: { name: string; href: string; external?: boolean }[] }[] = [
  {
    title: 'Resources',
    links: [
      { name: 'Wire Protocol', href: '/wire-protocol' },
      { name: 'Benchmarks', href: '/benchmarks' },
      { name: 'GitHub', href: 'https://github.com/Query-farm', external: true },
      { name: 'LLMs', href: '/llms.txt' },
    ],
  },
  {
    title: 'Implementations',
    links: [
      { name: 'Python', href: 'https://vgi-rpc-python.query.farm', external: true },
      { name: 'TypeScript', href: 'https://vgi-rpc-typescript.query.farm', external: true },
      { name: 'Go', href: 'https://vgi-rpc-go.query.farm', external: true },
      { name: 'Rust', href: 'https://docs.rs/vgi-rpc', external: true },
      { name: 'Java', href: 'https://javadoc.io/doc/farm.query/vgirpc', external: true },
      { name: 'C#', href: 'https://github.com/Query-farm/vgi-rpc-csharp#readme', external: true },
      { name: 'C++', href: 'https://vgi-rpc-cpp.query.farm', external: true },
    ],
  },
  {
    title: 'Query.Farm',
    links: [
      { name: 'VGI', href: 'https://query.farm/vgi', external: true },
      { name: 'Products', href: 'https://query.farm/products', external: true },
      { name: 'Blog', href: 'https://query.farm/blog', external: true },
      { name: 'Contact', href: 'https://query.farm/company/contact', external: true },
    ],
  },
];

const linkClass = `text-sm no-underline transition-colors
  text-soil-700 hover:text-link dark:text-cream-2 dark:hover:text-link-dark`;
---

<footer class="mt-auto border-t border-soil-300 bg-soil-100 dark:border-rock-700 dark:bg-rock-950">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid gap-10 py-12 lg:grid-cols-[1.1fr_2fr] lg:gap-14">
      <!-- Brand -->
      <div>
        <a href="https://query.farm" target="_blank" rel="noopener noreferrer"
          class="inline-flex items-center gap-[0.32em] no-underline text-soil-900 dark:text-cream">
          <StrataSun size={30} animate={false} />
          <span class="qf-wordmark text-[21px]">Query<span class="text-sun-700 dark:text-sun-400">.</span>Farm</span>
        </a>
        <p class="mt-5 max-w-[40ch] text-sm leading-relaxed text-soil-700 dark:text-cream-2">
          <span class="font-mono font-semibold text-soil-900 dark:text-cream">vgi-rpc</span> is
          transport-agnostic RPC built on Apache Arrow IPC serialization, made by Query.Farm.
        </p>
      </div>

      <!-- Link columns -->
      <nav class="grid grid-cols-2 gap-x-7 gap-y-9 sm:grid-cols-3" aria-label="Footer">
        {columns.map(col => (
          <div>
            <h2 class="qf-eyebrow mb-3 text-soil-500 dark:text-cream-2">{col.title}</h2>
            <ul class="flex list-none flex-col gap-[7px]">
              {col.links.map(link => (
                <li>
                  <a
                    href={link.href}
                    class={linkClass}
                    {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  >
                    {link.name}
                    {link.external && (
                      <svg class="ml-1 inline-block h-3 w-3 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                      </svg>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <div class="flex flex-col gap-3 border-t border-soil-300 py-5 pb-9 text-[13px] text-soil-600
      dark:border-rock-700 dark:text-cream-2 md:flex-row md:items-start md:justify-between md:gap-10">
      <span class="font-medium whitespace-nowrap">&copy; {year} Query Farm LLC &middot; All rights reserved</span>
      <p class="max-w-[70ch] text-xs leading-relaxed md:text-right">
        Apache, Apache Arrow, Arrow, and the Apache Arrow project logo are either registered trademarks or trademarks of{' '}
        <a href="https://www.apache.org/" target="_blank" rel="noopener noreferrer"
          class="no-underline transition-colors hover:text-link dark:hover:text-link-dark">The Apache Software Foundation</a>.
      </p>
    </div>
  </div>
</footer>
