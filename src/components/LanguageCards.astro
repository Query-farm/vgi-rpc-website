---
import RpcIllustration from './RpcIllustration.astro';
const languages = [
  {
    name: 'Python',
    status: 'Reference Implementation',
    description: "The Python reference with typed proxies, streaming, reflection, shared memory, worker pooling, and OpenTelemetry. Optional iroh extra provides native raw Iroh and HTTP-over-Iroh clients.",
    repo: 'https://github.com/Query-farm/vgi-rpc-python',
    docs: 'https://vgi-rpc-python.query.farm',
    package: 'https://pypi.org/project/vgi-rpc/',
    packageLabel: 'pip install vgi-rpc',
    logo: '/logos/python.svg',
  },
  {
    name: 'TypeScript',
    description: "TypeScript clients and workers for Bun, Node.js, and Deno. Includes HTTP, raw Iroh, and HTTP over Iroh, external storage, and OpenTelemetry. Native Iroh uses Node/Bun bindings; browser integration needs a separate adapter.",
    repo: 'https://github.com/Query-farm/vgi-rpc-typescript',
    docs: 'https://vgi-rpc-typescript.query.farm',
    package: 'https://www.npmjs.com/package/@query-farm/vgi-rpc',
    packageLabel: 'npm install @query-farm/vgi-rpc',
    logo: '/logos/typescript.svg',
  },
  {
    name: 'Go',
    description: "Go workers and schema-first clients for HTTP and streaming, with zstd request compression and external payloads. Raw Iroh and HTTP over Iroh use an explicitly supplied native or community provider.",
    repo: 'https://github.com/Query-farm/vgi-rpc-go',
    docs: 'https://vgi-rpc-go.query.farm',
    package: 'https://pkg.go.dev/github.com/Query-farm/vgi-rpc-go/vgirpc',
    packageLabel: 'go get github.com/Query-farm/vgi-rpc-go/vgirpc',
    logo: '/logos/go.svg',
  },
  {
    name: 'Rust',
    description: "Rust clients and servers with derive macros, streaming, shared memory, and HTTP. Optional crates add native Iroh hosting and clients, HTTP over Iroh, and a standalone bridge for other language workers.",
    repo: 'https://github.com/Query-farm/vgi-rpc-rust',
    docs: 'https://docs.rs/vgi-rpc',
    package: 'https://crates.io/crates/vgi-rpc',
    packageLabel: 'cargo add vgi-rpc',
    logo: '/logos/rust.svg',
  },
  {
    name: 'Java',
    description: "Java 21+ typed unary and streaming clients over subprocess, Unix, TCP, and HTTP with compression and external payloads. The optional vgirpc-iroh module adds both Iroh modes; worker shared memory requires JDK 22+.",
    repo: 'https://github.com/Query-farm/vgi-rpc-java',
    docs: 'https://javadoc.io/doc/farm.query/vgirpc',
    package: 'https://central.sonatype.com/artifact/farm.query/vgirpc',
    packageLabel: 'implementation("farm.query:vgirpc:0.27.1")',
    logo: '/logos/java.svg',
  },
  {
    name: 'C#',
    description: ".NET 10 typed and schema-first clients with unary and streaming calls, subprocess pooling, shared memory, HTTP compression, external payloads, and Iroh connectors. Client, HTTP client, and OAuth integrations ship as separate packages.",
    repo: 'https://github.com/Query-farm/vgi-rpc-csharp',
    docs: 'https://github.com/Query-farm/vgi-rpc-csharp#readme',
    package: 'https://www.nuget.org/packages/QueryFarm.VgiRpc/',
    packageLabel: 'dotnet add package QueryFarm.VgiRpc',
    logo: '/logos/csharp.svg',
  },
  {
    name: 'C++',
    description: "C++20 clients and workers with unary and streaming RPCs, shared memory, HTTP compression, and external storage. Build with VGI_RPC_WITH_IROH_CABI for native raw Iroh and HTTP-over-Iroh clients.",
    repo: 'https://github.com/Query-farm/vgi-rpc-cpp',
    docs: 'https://vgi-rpc-cpp.query.farm',
    package: null,
    packageLabel: null,
    logo: '/logos/cpp.svg',
  },
];
---

<section id="languages" class="py-20 md:py-24 bg-soil-100 dark:bg-rock-950/50">
  <div class="illustrated-section max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <RpcIllustration variant="languages" class="section-illustration" />
    <h2 class="text-3xl md:text-4xl text-center
      text-soil-900 dark:text-cream">
      Choose your language.
    </h2>
    <p class="mt-3 text-center text-lg text-soil-700 dark:text-cream-2 max-w-2xl mx-auto">
      One wire protocol, multiple languages. All implementations interoperate via subprocess transport.
    </p>

    <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-6">
      {languages.map(lang => (
        <div class="language-entry flex flex-col p-6 rounded-xl border shadow-sm
          bg-white border-soil-300/60
          dark:bg-rock-800 dark:border-rock-700 dark:shadow-none">
          <div class="flex items-start justify-between">
            <div class="flex items-center gap-3">
              <img src={lang.logo} alt={`${lang.name} logo`} class:list={['w-8 h-8', (lang.name === 'Rust' || lang.name === 'Java') && 'dark:invert']} />
              <div>
                <h3 class="text-xl text-soil-900 dark:text-cream">
                  {lang.name}
                </h3>
                {lang.status && (
                  <span class="mt-1 inline-flex items-center rounded-full border px-2.5 py-0.5 text-[12.5px] font-medium leading-normal
                    border-field-600/45 bg-field-600/10 text-field-700
                    dark:border-field-400/40 dark:bg-field-400/10 dark:text-field-400">
                    {lang.status}
                  </span>
                )}
              </div>
            </div>
          </div>

          <p class="mt-3 text-sm text-soil-700 dark:text-cream-2 leading-relaxed">
            {lang.description}
          </p>

          <div class="language-activity">
            <a href={`${lang.repo}/actions`} target="_blank" rel="noopener noreferrer">Build status ↗</a>
            <a href={`${lang.repo}/commits/main`} target="_blank" rel="noopener noreferrer">Recent commits ↗</a>
            <a href={`${lang.repo}?tab=license-1-ov-file`} target="_blank" rel="noopener noreferrer">License ↗</a>
          </div>

          <div class="mt-auto pt-5 flex flex-wrap gap-2">
            <a href={lang.repo} target="_blank" rel="noopener noreferrer"
              class="inline-flex items-center gap-1 rounded-lg border px-[13px] py-[6px] text-[12.5px] font-medium leading-tight
                border-soil-300 text-soil-700 hover:border-soil-900 hover:text-soil-900
                dark:border-white/25 dark:text-cream dark:hover:border-white/45 dark:hover:bg-white/10
                transition-colors">
              GitHub <span aria-hidden="true">&nearr;</span>
            </a>
            {lang.docs && (
              <a href={lang.docs} target="_blank" rel="noopener noreferrer"
                class="inline-flex items-center gap-1 rounded-lg border px-[13px] py-[6px] text-[12.5px] font-medium leading-tight
                border-soil-300 text-soil-700 hover:border-soil-900 hover:text-soil-900
                dark:border-white/25 dark:text-cream dark:hover:border-white/45 dark:hover:bg-white/10
                transition-colors">
                Docs <span aria-hidden="true">&nearr;</span>
              </a>
            )}
            {lang.package && (
              <a href={lang.package} target="_blank" rel="noopener noreferrer"
                class="inline-flex items-center gap-1 rounded-lg border px-[13px] py-[6px] text-[12.5px] font-medium leading-tight
                border-soil-300 text-soil-700 hover:border-soil-900 hover:text-soil-900
                dark:border-white/25 dark:text-cream dark:hover:border-white/45 dark:hover:bg-white/10
                transition-colors">
                Package <span aria-hidden="true">&nearr;</span>
              </a>
            )}
          </div>

          {lang.packageLabel && (
            <div class="mt-3">
              <code class="block break-all rounded-lg border border-rock-800 bg-rock-900 px-3 py-2 text-[13px] text-cream">
                {lang.packageLabel}
              </code>
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
