---
import capabilities from '../data/capabilities.json';
import CapabilityTable from './CapabilityTable.astro';

const languages = ['python', 'typescript', 'go', 'rust', 'java', 'csharp', 'cpp'] as const;
type LangKey = typeof languages[number];
type CellValue = boolean | string;

interface ClientCapabilities {
  available: boolean;
  scope: string;
  api_style: string;
  patterns: Record<string, boolean>;
  transports: Record<string, CellValue>;
  features: Record<string, CellValue>;
}

interface LanguageCapabilities {
  transports: Record<string, boolean>;
  patterns: Record<string, boolean>;
  features: Record<string, boolean>;
  client: ClientCapabilities;
}

const languageData = capabilities.languages as unknown as Record<LangKey, LanguageCapabilities>;
const langLabels: Record<string, string> = {
  python: 'Python',
  typescript: 'TypeScript',
  go: 'Go',
  rust: 'Rust',
  java: 'Java',
  csharp: 'C#',
  cpp: 'C++',
};

const valuesFor = (select: (language: LanguageCapabilities) => CellValue) =>
  Object.fromEntries(languages.map(language => [language, select(languageData[language])]));

const rowsFor = (
  labels: Record<string, string>,
  select: (language: LanguageCapabilities, key: string) => CellValue,
) => Object.entries(labels).map(([key, label]) => ({
  label,
  values: valuesFor(language => select(language, key)),
}));

const clientImplementationRows = [
  { label: 'Client Library', values: valuesFor(language => language.client.available) },
  { label: 'Scope', values: valuesFor(language => language.client.scope) },
  { label: 'API Model', values: valuesFor(language => language.client.api_style) },
  ...rowsFor({
    unary: 'Unary Calls',
    producer: 'Producer Streams',
    exchange: 'Exchange Streams',
  }, (language, key) => language.client.patterns[key]),
];

const clientConnectionRows = [
  { group: 'transports', key: 'subprocess', label: 'Subprocess Launcher' },
  { group: 'transports', key: 'unix_socket', label: 'Unix Socket' },
  { group: 'transports', key: 'tcp', label: 'TCP Socket' },
  { group: 'transports', key: 'http', label: 'HTTP' },
  { group: 'transports', key: 'http_zstd', label: 'HTTP zstd' },
  { group: 'transports', key: 'shared_memory', label: 'Shared Memory' },
  { group: 'features', key: 'worker_pool', label: 'Worker Pool' },
] as const;
const clientConnectionTableRows = clientConnectionRows.map(row => ({
  label: row.label,
  values: valuesFor(language => language.client[row.group][row.key]),
}));

const clientServiceRows = rowsFor({
  introspection: 'Service Introspection',
  authentication: 'Authentication Headers',
  client_logging: 'Client Log Callback',
  external_storage: 'External Payload Resolution',
}, (language, key) => language.client.features[key]);

const workerTransportRows = rowsFor({
  pipe: 'In-process Pipe',
  stdio: 'Stdio Worker',
  unix_socket: 'Unix Socket',
  tcp: 'TCP Socket',
  shared_memory: 'Shared Memory',
  http: 'HTTP',
}, (language, key) => language.transports[key]);

const workerPatternRows = rowsFor({
  unary: 'Unary',
  unary_void: 'Unary (void)',
  producer: 'Producer',
  producer_with_header: 'Producer + Header',
  exchange: 'Exchange',
  exchange_with_header: 'Exchange + Header',
}, (language, key) => language.patterns[key]);

const workerFeatureRows = rowsFor({
  introspection: 'Introspection',
  client_logging: 'Client-directed Logs',
  error_propagation: 'Error Propagation',
  complex_types: 'Complex Types',
  optional_types: 'Optional Types',
  dataclass_types: 'Dataclass Types',
  annotated_types: 'Annotated Types',
  authentication: 'Authentication',
  external_storage: 'External Storage',
  opentelemetry: 'OpenTelemetry',
}, (language, key) => language.features[key]);
---

<section id="capabilities" class="py-20 border-t border-farm-cream-dark dark:border-farm-dark-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl md:text-4xl font-bold text-center text-farm-green-deep dark:text-farm-cream">
      Capability Matrix
    </h2>
    <p class="mt-3 text-center text-lg text-farm-text-muted dark:text-farm-text-light-muted max-w-2xl mx-auto">
      Native client coverage is tracked separately from worker/server conformance so client-only features are not mistaken for transports.
    </p>

    <div class="mt-10">
      <h3 class="text-lg font-semibold text-farm-green-deep dark:text-farm-cream">Client Implementations</h3>
      <p class="mt-1 mb-4 text-sm text-farm-text-muted dark:text-farm-text-light-muted">
        All maintained ports ship a native client surface, but their API scope and supported call patterns differ.
      </p>
      <CapabilityTable firstColumnLabel="Client Surface" {languages} languageLabels={langLabels} rows={clientImplementationRows} />
    </div>

    <div class="mt-8">
      <h3 class="text-lg font-semibold text-farm-green-deep dark:text-farm-cream mb-4">Client Connections &amp; Orchestration</h3>
      <CapabilityTable firstColumnLabel="Client Capability" {languages} languageLabels={langLabels} rows={clientConnectionTableRows} />
    </div>

    <div class="mt-8">
      <h3 class="text-lg font-semibold text-farm-green-deep dark:text-farm-cream mb-4">Client Services</h3>
      <CapabilityTable firstColumnLabel="Client Capability" {languages} languageLabels={langLabels} rows={clientServiceRows} />
      <p class="mt-3 text-xs text-farm-text-muted dark:text-farm-text-light-muted">
        <strong>Partial</strong> denotes a lower-level or transport-limited client surface. Go decodes zstd HTTP responses but sends identity requests; Java resolves external payloads on raw connections but not its HTTP client; C# provides a typed unary client over connected transports plus lower-level subprocess, HTTP, authentication, and external-resolution building blocks.
      </p>
    </div>

    <div class="mt-12 border-t border-farm-cream-dark pt-10 dark:border-farm-dark-border">
      <h3 class="text-lg font-semibold text-farm-green-deep dark:text-farm-cream">Worker Transports</h3>
      <p class="mt-1 mb-4 text-sm text-farm-text-muted dark:text-farm-text-light-muted">
        Ways each implementation can host a worker. Stdio availability does not imply a native subprocess-launching client.
      </p>
      <CapabilityTable firstColumnLabel="Worker Transport" {languages} languageLabels={langLabels} rows={workerTransportRows} />
    </div>

    <div class="mt-8">
      <h3 class="text-lg font-semibold text-farm-green-deep dark:text-farm-cream mb-4">Worker RPC Patterns</h3>
      <CapabilityTable firstColumnLabel="Pattern" {languages} languageLabels={langLabels} rows={workerPatternRows} />
    </div>

    <div class="mt-8">
      <h3 class="text-lg font-semibold text-farm-green-deep dark:text-farm-cream mb-4">Worker Features</h3>
      <CapabilityTable firstColumnLabel="Feature" {languages} languageLabels={langLabels} rows={workerFeatureRows} />
    </div>

    <p class="mt-6 text-center text-xs text-farm-text-muted dark:text-farm-text-light-muted">
      Last updated: {new Date(capabilities.generated_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
    </p>
  </div>
</section>
