---
import capabilities from '../data/capabilities.json';
import reviewedSources from '../../scripts/capability-sources.json';
import CapabilityTable from './CapabilityTable.astro';

const languages = ['python', 'typescript', 'go', 'rust', 'java', 'csharp', 'cpp'] as const;
type LangKey = typeof languages[number];
type CellValue = boolean | string;

interface ClientCapabilities {
  available: boolean;
  scope: string;
  api_style: string;
  patterns: Record<string, boolean>;
  transports: Record<string, CellValue>;
  features: Record<string, CellValue>;
}

interface LanguageCapabilities {
  transports: Record<string, boolean>;
  patterns: Record<string, boolean>;
  features: Record<string, boolean>;
  client: ClientCapabilities;
}

const languageData = capabilities.languages as unknown as Record<LangKey, LanguageCapabilities>;
const langLabels: Record<string, string> = {
  python: 'Python',
  typescript: 'TypeScript',
  go: 'Go',
  rust: 'Rust',
  java: 'Java',
  csharp: 'C#',
  cpp: 'C++',
};

const valuesFor = (select: (language: LanguageCapabilities) => CellValue) =>
  Object.fromEntries(languages.map(language => [language, select(languageData[language])]));

const rowsFor = (
  labels: Record<string, string>,
  select: (language: LanguageCapabilities, key: string) => CellValue,
) => Object.entries(labels).map(([key, label]) => ({
  label,
  values: valuesFor(language => select(language, key)),
}));

const clientImplementationRows = [
  { label: 'Client Library', values: valuesFor(language => language.client.available) },
  { label: 'Scope', values: valuesFor(language => language.client.scope) },
  { label: 'API Model', values: valuesFor(language => language.client.api_style) },
  ...rowsFor({
    unary: 'Unary Calls',
    producer: 'Producer Streams',
    exchange: 'Exchange Streams',
  }, (language, key) => language.client.patterns[key]),
];

const clientConnectionRows = [
  { group: 'transports', key: 'subprocess', label: 'Subprocess Launcher' },
  { group: 'transports', key: 'unix_socket', label: 'Unix Socket' },
  { group: 'transports', key: 'tcp', label: 'TCP Socket' },
  { group: 'transports', key: 'http', label: 'HTTP' },
  { group: 'transports', key: 'http_zstd', label: 'HTTP zstd' },
  { group: 'transports', key: 'iroh', label: 'Iroh (iroh://)' },
  { group: 'transports', key: 'httpi', label: 'HTTP over Iroh (httpi://)' },
  { group: 'transports', key: 'shared_memory', label: 'Shared Memory' },
  { group: 'features', key: 'worker_pool', label: 'Worker Pool' },
] as const;
const clientConnectionTableRows = clientConnectionRows.map(row => ({
  label: row.label,
  values: valuesFor(language => language.client[row.group][row.key]),
}));

const clientServiceRows = rowsFor({
  introspection: 'Service Introspection',
  authentication: 'Authentication Headers',
  client_logging: 'Client Log Callback',
  external_storage: 'External Payload Resolution',
}, (language, key) => language.client.features[key]);

const workerTransportRows = rowsFor({
  pipe: 'In-process Pipe',
  stdio: 'Stdio Worker',
  unix_socket: 'Unix Socket',
  tcp: 'TCP Socket',
  shared_memory: 'Shared Memory',
  http: 'HTTP',
}, (language, key) => language.transports[key]);

const workerPatternRows = rowsFor({
  unary: 'Unary',
  unary_void: 'Unary (void)',
  producer: 'Producer',
  producer_with_header: 'Producer + Header',
  exchange: 'Exchange',
  exchange_with_header: 'Exchange + Header',
}, (language, key) => language.patterns[key]);

const workerFeatureRows = rowsFor({
  introspection: 'Introspection',
  client_logging: 'Client-directed Logs',
  error_propagation: 'Error Propagation',
  complex_types: 'Complex Types',
  optional_types: 'Optional Types',
  dataclass_types: 'Dataclass Types',
  annotated_types: 'Annotated Types',
  authentication: 'Authentication',
  external_storage: 'External Storage',
  opentelemetry: 'OpenTelemetry',
}, (language, key) => language.features[key]);

// Summary view: most cells are plain ✓, so lead with what is universal and
// spend the space on the cells that differ. Everything is derived from the
// data so it stays right when scripts/test-capabilities.py regenerates it.
const isUniform = (values: Record<string, CellValue>) => {
  const first = values[languages[0]];
  return languages.every(language => values[language] === first);
};
const missingLabel = (value: CellValue | undefined) =>
  value === undefined || value === null || value === '' ? 'not declared for' : 'not in';

const workerRows = [
  ...workerTransportRows.map(row => ({ ...row, exceptionLabel: `${row.label} transport` })),
  ...workerPatternRows,
  ...workerFeatureRows,
].map(row => ({ exceptionLabel: row.label, ...row }));
const workerUniversal = workerRows.filter(row => languages.every(language => row.values[language] === true));
const workerExceptions = workerRows
  .filter(row => !languages.every(language => row.values[language] === true))
  .map(row => {
    const lacking = languages.filter(language => row.values[language] !== true);
    return {
      label: row.exceptionLabel,
      verb: missingLabel(row.values[lacking[0]]),
      languages: lacking.map(language => langLabels[language]),
    };
  });

// Client columns, in reading order. A column whose value is the same in every
// language moves to the "every client supports" line instead.
const clientColumnCandidates = [
  { label: 'API style', values: valuesFor(language => language.client.api_style) },
  { label: 'Subprocess', values: valuesFor(language => language.client.transports.subprocess) },
  { label: 'Unix socket', values: valuesFor(language => language.client.transports.unix_socket) },
  { label: 'TCP', values: valuesFor(language => language.client.transports.tcp) },
  { label: 'Shared memory', values: valuesFor(language => language.client.transports.shared_memory) },
  { label: 'HTTP', values: valuesFor(language => language.client.transports.http) },
  { label: 'HTTP zstd', values: valuesFor(language => language.client.transports.http_zstd) },
  ...(languages.every(language => languageData[language].client.transports.iroh === languageData[language].client.transports.httpi)
    ? [{ label: 'Iroh + httpi', values: valuesFor(language => language.client.transports.iroh) }]
    : [
        { label: 'Iroh', values: valuesFor(language => language.client.transports.iroh) },
        { label: 'httpi', values: valuesFor(language => language.client.transports.httpi) },
      ]),
  { label: 'Worker pool', values: valuesFor(language => language.client.features.worker_pool) },
  { label: 'Introspection', values: valuesFor(language => language.client.features.introspection) },
  ...clientImplementationRows.slice(3).map(row => ({ label: row.label, values: row.values })),
  ...clientServiceRows.filter(row => row.label !== 'Service Introspection'),
];
const clientColumns = clientColumnCandidates.filter(column => !isUniform(column.values));
const clientUniversal = clientColumnCandidates
  .filter(column => isUniform(column.values) && column.values[languages[0]] === true)
  .map(column => column.label);

const badgeText: Record<string, string> = {
  'Optional native': 'Optional',
  'Provider required': 'Provider',
};
---

<section id="capabilities" class="py-20 md:py-24 bg-soil-50 dark:bg-rock-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl md:text-4xl text-center text-soil-900 dark:text-cream">
      What Each SDK Supports
    </h2>
    <p class="mt-3 text-center text-lg text-soil-700 dark:text-cream-2 max-w-2xl mx-auto">
      Workers are close to complete in every language; clients differ by API style and transport. These are declarations reviewed against each SDK’s documentation, not a fresh cross-language conformance run.
    </p>

    <div class="mt-12 grid gap-8 lg:grid-cols-[1fr_2fr]">
      <div>
        <h3 class="text-xl text-soil-900 dark:text-cream">Workers</h3>
        <p class="mt-2 text-soil-700 dark:text-cream-2">
          Every worker SDK supports <span class="qf-figure font-semibold text-soil-900 dark:text-cream">{workerUniversal.length}</span> of the {workerRows.length} worker capabilities we track. The exceptions:
        </p>
        <ul class="mt-4 space-y-2">
          {workerExceptions.map(exception => (
            <li class="rounded-lg border border-cat-clay-ink/20 bg-cat-clay/60 px-3 py-2 text-sm text-soil-900 dark:border-sun-400/25 dark:bg-sun-400/10 dark:text-cream">
              <strong class="font-semibold">{exception.label}</strong>
              <span class="text-soil-700 dark:text-cream-2"> {exception.verb} {exception.languages.join(', ')}</span>
            </li>
          ))}
        </ul>
        <p class="mt-5 qf-eyebrow text-soil-600 dark:text-cream-2">Supported by all seven</p>
        <ul class="mt-2 flex flex-wrap gap-1.5">
          {workerUniversal.map(row => (
            <li class="rounded-md border border-soil-300 bg-white px-2 py-0.5 text-xs text-soil-700 dark:border-rock-700 dark:bg-rock-800 dark:text-cream-2">{row.label}</li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-xl text-soil-900 dark:text-cream">Clients</h3>
        <p class="mt-2 text-soil-700 dark:text-cream-2">
          Clients are where the ports differ. The table shows only the capabilities that vary.
        </p>
        <p class="mt-4 qf-eyebrow text-soil-600 dark:text-cream-2">Supported by every client</p>
        <ul class="mt-2 flex flex-wrap gap-1.5">
          {clientUniversal.map(label => (
            <li class="rounded-md border border-soil-300 bg-white px-2 py-0.5 text-xs text-soil-700 dark:border-rock-700 dark:bg-rock-800 dark:text-cream-2">{label}</li>
          ))}
        </ul>
        <div class="mt-4 overflow-x-auto rounded-xl border border-soil-300 bg-white shadow-sm dark:border-rock-700 dark:bg-rock-800 dark:shadow-none">
          <table class="w-full min-w-[640px] border-collapse text-[14px]">
            <thead>
              <tr class="border-b border-soil-300 bg-[#fbf7ee] dark:border-rock-700 dark:bg-rock-950/40">
                <th class="text-left px-[14px] py-2.5 text-[12.5px] font-semibold whitespace-nowrap text-soil-600 dark:text-cream-2">Language</th>
                {clientColumns.map(column => (
                  <th class="px-[10px] py-2.5 text-center text-[12.5px] font-semibold text-soil-600 dark:text-cream-2">{column.label}</th>
                ))}
              </tr>
            </thead>
            <tbody class="divide-y divide-soil-200 dark:divide-rock-700">
              {languages.map(language => (
                <tr>
                  <th scope="row" class="px-[14px] py-2.5 text-left font-medium whitespace-nowrap text-soil-900 dark:text-cream">{langLabels[language]}</th>
                  {clientColumns.map(column => {
                    const value = column.values[language];
                    return (
                      <td class="px-[10px] py-2.5 text-center">
                        {value === true
                          ? <span class="font-semibold text-field-700 dark:text-field-400" aria-label="Supported" title="Supported">&#x2713;</span>
                          : value === false || value === undefined || value === null || value === ''
                            ? <span class="text-soil-300 dark:text-rock-700" aria-label="Not supported" title="Not supported">&#x2014;</span>
                            : <span class="inline-flex items-center justify-center rounded-md border px-2 py-0.5 text-[11.5px] font-medium leading-snug whitespace-nowrap border-soil-300 bg-soil-100/70 text-soil-700 dark:border-rock-700 dark:bg-rock-900 dark:text-cream-2">{badgeText[value] ?? value}</span>}
                      </td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-3 text-xs text-soil-700 dark:text-cream-2">
          <strong>Optional</strong> Iroh support requires the language’s Iroh binding or build feature; TypeScript’s targets Node/Bun, and browsers need a separate adapter. Go requires an explicit <strong>provider</strong>; none is bundled. <strong>Schema-first</strong> clients call methods and reflection through a generic RPC API rather than generated or typed proxies.
        </p>
      </div>
    </div>

    <details class="group mt-12 rounded-xl border border-soil-300 bg-white/60 dark:border-rock-700 dark:bg-rock-800/40">
      <summary class="cursor-pointer list-none px-5 py-4 font-medium text-soil-900 dark:text-cream">
        <span class="mr-2 inline-block transition-transform group-open:rotate-90" aria-hidden="true">&#x203A;</span>
        Full capability matrix
        <span class="ml-1 text-sm font-normal text-soil-700 dark:text-cream-2">(every declared capability, by language)</span>
      </summary>
      <div class="border-t border-soil-300 px-5 pb-6 dark:border-rock-700">
        <div class="mt-10">
          <h3 class="text-lg text-soil-900 dark:text-cream">Client Implementations</h3>
          <p class="mt-1 mb-4 text-sm text-soil-700 dark:text-cream-2">
            All maintained ports ship a native client surface, but their API scope and supported call patterns differ.
          </p>
          <CapabilityTable firstColumnLabel="Client Surface" {languages} languageLabels={langLabels} rows={clientImplementationRows} />
        </div>

        <div class="mt-8">
          <h3 class="text-lg text-soil-900 dark:text-cream mb-4">Client Connections &amp; Orchestration</h3>
          <CapabilityTable firstColumnLabel="Client Capability" {languages} languageLabels={langLabels} rows={clientConnectionTableRows} />
        </div>

        <div class="mt-8">
          <h3 class="text-lg text-soil-900 dark:text-cream mb-4">Client Services</h3>
          <CapabilityTable firstColumnLabel="Client Capability" {languages} languageLabels={langLabels} rows={clientServiceRows} />
          <p class="mt-3 text-xs text-soil-700 dark:text-cream-2">
            <strong>Optional native</strong> requires the language’s Iroh binding or build feature. Go requires an explicit provider; no native Go provider is bundled. TypeScript native Iroh targets Node/Bun; browsers require a separate adapter. <strong>Schema-first</strong> means callers invoke reflection through the generic RPC API. Java’s shared-memory entry here describes the native client, separately from its worker-side support.
          </p>
        </div>

        <div class="mt-12 border-t border-soil-300 pt-10 dark:border-rock-700">
          <h3 class="text-lg text-soil-900 dark:text-cream">Worker Transports</h3>
          <p class="mt-1 mb-4 text-sm text-soil-700 dark:text-cream-2">
            Ways each implementation can host a worker. All seven can expose raw or HTTP workers through the standalone Iroh bridge; Rust also offers an embedded native Iroh server. Stdio availability does not imply a native subprocess-launching client.
          </p>
          <CapabilityTable firstColumnLabel="Worker Transport" {languages} languageLabels={langLabels} rows={workerTransportRows} />
        </div>

        <div class="mt-8">
          <h3 class="text-lg text-soil-900 dark:text-cream mb-4">Worker RPC Patterns</h3>
          <CapabilityTable firstColumnLabel="Pattern" {languages} languageLabels={langLabels} rows={workerPatternRows} />
        </div>

        <div class="mt-8">
          <h3 class="text-lg text-soil-900 dark:text-cream mb-4">Worker Features</h3>
          <CapabilityTable firstColumnLabel="Feature" {languages} languageLabels={langLabels} rows={workerFeatureRows} />
        </div>
      </div>
    </details>

    <div class="mt-6 text-sm text-soil-700 dark:text-cream-2">
      <p>SDK sources reviewed {reviewedSources.python.reviewed_at}. Benchmark results retain the versions used for their measured runs.</p>
      <ul class="mt-2 flex flex-wrap gap-x-5 gap-y-2">
        {languages.map(language => (
          <li><a href={reviewedSources[language].source} target="_blank" rel="noopener noreferrer" class="qf-link">{langLabels[language]} {reviewedSources[language].version}</a></li>
        ))}
      </ul>
    </div>
    <p class="mt-6 text-center text-xs text-soil-700 dark:text-cream-2">
      Last updated: {new Date(capabilities.generated_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
    </p>
  </div>
</section>
