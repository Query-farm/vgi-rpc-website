---
import TransportIcon from './TransportIcon.astro';

const transports = [
  {
    name: 'Pipe',
    icon: 'pipe',
    description: 'In-process, bidirectional byte stream. Lowest latency — ideal for tests and embedded use.',
    scope: 'In-process',
    useCase: 'Testing, demos',
  },
  {
    name: 'Subprocess',
    icon: 'subprocess',
    description: 'Spawn a worker process, communicate over stdin/stdout. Process isolation with low overhead.',
    scope: 'Process IPC',
    useCase: 'Isolated workers, CLI tools',
  },
  {
    name: 'Unix Socket',
    icon: 'unix-socket',
    description: 'Kernel-mediated local IPC. Long-lived connections with per-client threading support.',
    scope: 'Local IPC',
    useCase: 'Local services, daemons',
  },
  {
    name: 'TCP',
    icon: 'tcp',
    description: 'Lean Arrow IPC framing over a persistent socket. Intended for trusted networks; use HTTP with TLS or Iroh for authenticated network connections.',
    scope: 'Network',
    useCase: 'Trusted network services',
  },
  {
    name: 'Shared Memory',
    icon: 'shared-memory',
    description: 'Zero-copy Arrow batch transfer via memory-mapped segments. Only pointers cross the pipe.',
    scope: 'Zero-copy side channel',
    useCase: 'Large batches, co-located',
  },
  {
    name: 'HTTP',
    icon: 'http',
    description: 'HTTP transport with authenticated stream state, compression, capability discovery, external payloads, and optional sticky sessions.',
    scope: 'Network + HTTP',
    useCase: 'Network services, browsers',
  },
  {
    name: 'Iroh',
    icon: 'iroh',
    description: 'iroh:// carries stateful Arrow RPC over authenticated QUIC. Independent logical streams share a connection while each stream keeps its worker state in memory.',
    scope: 'Peer-to-peer network',
    useCase: 'Persistent streaming services',
  },
  {
    name: 'HTTP over Iroh',
    icon: 'http-over-iroh',
    description: 'httpi:// carries HTTP request/response semantics over Iroh. Retains capability discovery, sealed continuation tokens, compression, and external payloads.',
    scope: 'HTTP semantics + QUIC',
    useCase: 'HTTP workers behind a bridge',
  },
] as const;
---

<section id="transports" class="py-20 md:py-24 bg-soil-50 dark:bg-rock-900">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl md:text-4xl text-center
      text-soil-900 dark:text-cream">
      Transports and Side Channels
    </h2>
    <p class="mt-3 text-center text-lg text-soil-700 dark:text-cream-2 max-w-2xl mx-auto">
      Pick a transport by how far the caller sits from the worker: the same process, the same machine, or across a network.
    </p>

    <p class="mt-4 text-center text-sm text-soil-700 dark:text-cream-2 max-w-3xl mx-auto">
      Rust can host Iroh directly; workers in every language can use the standalone bridge.
      Native clients require the optional binding or provider for their language.{' '}
      <a href="/wire-protocol#iroh" class="qf-link">Iroh modes, setup, and identity &rarr;</a>
    </p>

    <div class="mt-12 space-y-4">
      {transports.map(transport => (
        <div class="flex flex-col md:flex-row items-start md:items-center gap-4 md:gap-6 p-5 rounded-xl border shadow-sm
          bg-white border-soil-300/60
          dark:bg-rock-800 dark:border-rock-700 dark:shadow-none">
          <div class="flex-shrink-0 flex items-center gap-4 w-full md:w-64">
            <TransportIcon transport={transport.icon} />
            <div>
              <h3 class="text-xl text-soil-900 dark:text-cream">
                {transport.name}
              </h3>
              <span class="qf-eyebrow block mt-0.5 text-sun-700 dark:text-sun-300">
                {transport.scope}
              </span>
            </div>
          </div>
          <p class="flex-1 text-[14.5px] leading-relaxed text-soil-700 dark:text-cream-2">
            {transport.description}
          </p>
          <span class="flex-shrink-0 inline-flex items-center rounded-full border px-2.5 py-0.5 text-[12.5px] font-medium leading-normal
            border-soil-300 bg-soil-100/70 text-soil-700
            dark:border-rock-700 dark:bg-rock-900 dark:text-cream-2">
            {transport.useCase}
          </span>
        </div>
      ))}
    </div>
  </div>
</section>
