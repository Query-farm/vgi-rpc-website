---
import benchmarkData from '../data/benchmarks.json';

type Result = {
  layer: string;
  server: string;
  transport: string;
  workload: string;
  concurrency?: number;
  status: string;
  mean_ns?: number;
  p50_ns?: number;
  payload_bytes_per_second?: number;
  operations_per_second?: number;
};
const results = (benchmarkData.results as Result[]).filter(result => result.layer === 'controlled' && result.status === 'complete');
const highlightSpecs = [
  { title: 'Mean unary latency', workload: 'add_floats', transport: 'stdio', concurrency: 1, field: 'mean_ns', aggregation: 'median', detail: 'Add two float64 values over subprocess stdio' },
  { title: 'Large-payload throughput', workload: 'echo_binary_16777216', transport: null, concurrency: 1, field: 'payload_bytes_per_second', aggregation: 'max', detail: null },
  { title: '16-client throughput', workload: 'add_floats_load', transport: 'unix', concurrency: 16, field: 'operations_per_second', aggregation: 'median', detail: 'Concurrent unary calls over Unix sockets' },
] as const;

const implementationNames = Object.fromEntries(benchmarkData.implementations.map(implementation => [implementation.id, implementation.name]));
const transportNames: Record<string, string> = {
  stdio: 'subprocess stdio',
  stdio_shm: 'shared memory',
  unix: 'Unix socket',
  tcp: 'TCP loopback',
  http_identity: 'HTTP identity',
  http_zstd: 'HTTP zstd',
};

function median(values: number[]): number | undefined {
  if (values.length === 0) return undefined;
  const ordered = [...values].sort((a, b) => a - b);
  const middle = Math.floor(ordered.length / 2);
  return ordered.length % 2 ? ordered[middle] : (ordered[middle - 1] + ordered[middle]) / 2;
}

const highlights = highlightSpecs.map(spec => {
  const matching = results.filter(result => result.workload === spec.workload && (spec.transport === null || result.transport === spec.transport) && (result.concurrency ?? 1) === spec.concurrency);
  const values = matching
    .map(result => result[spec.field])
    .filter((value): value is number => typeof value === 'number');
  const winner = spec.aggregation === 'max'
    ? matching.reduce<Result | undefined>((best, result) => {
        const value = result[spec.field];
        const bestValue = best?.[spec.field];
        return typeof value === 'number' && (typeof bestValue !== 'number' || value > bestValue) ? result : best;
      }, undefined)
    : undefined;
  return { ...spec, value: spec.aggregation === 'max' ? Math.max(...values) : median(values), count: values.length, winner };
});

function detail(highlight: typeof highlights[number]): string {
  if (highlight.winner) {
    return `16 MiB ${implementationNames[highlight.winner.server]} ${transportNames[highlight.winner.transport]} echo, bidirectional payload`;
  }
  return highlight.detail ?? '';
}

function format(highlight: typeof highlights[number]): string {
  const value = highlight.value;
  if (value === undefined) return 'Pending';
  if (highlight.field === 'mean_ns') {
    return `${(value / 1_000_000).toFixed(3)} ms`;
  }
  if (highlight.field === 'payload_bytes_per_second') {
    return `${(value / (1024 ** 3)).toFixed(2)} GiB/s`;
  }
  return `${value.toLocaleString('en-US', { minimumFractionDigits: 1, maximumFractionDigits: 1 })} calls/sec`;
}
---

<section id="benchmarks" class="py-20 border-t border-farm-cream-dark dark:border-farm-dark-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl md:text-4xl font-bold text-center text-farm-green-deep dark:text-farm-cream">Measured across implementations</h2>
    <p class="mt-3 text-center text-lg text-farm-text-muted dark:text-farm-text-light-muted max-w-3xl mx-auto">
      A fixed Rust client compares the latest release servers over real subprocess, socket, HTTP, and shared-memory transports.
    </p>

    {benchmarkData.status === 'published' ? (
      <div class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-3">
        {highlights.map(highlight => (
          <div class="rounded-xl border border-farm-cream-dark bg-white p-6 dark:border-farm-dark-border dark:bg-farm-dark-card">
            <p class="text-xs font-bold uppercase tracking-wider text-farm-text-muted dark:text-farm-text-light-muted">{highlight.title}</p>
            <p class="mt-3 font-mono text-3xl font-bold text-farm-gold">{format(highlight)}</p>
            <p class="mt-2 text-sm text-farm-text-muted dark:text-farm-text-light-muted">{detail(highlight)}</p>
            {highlight.count > 0 && (
              <p class="mt-3 text-xs text-farm-text-muted dark:text-farm-text-light-muted">
                {highlight.aggregation === 'max'
                  ? `Peak single-server-core result on ${benchmarkData.host.chip}; one outstanding call`
                  : `Median of ${highlight.count} stable latest-release servers`}
              </p>
            )}
          </div>
        ))}
      </div>
    ) : (
      <div class="mx-auto mt-10 max-w-3xl rounded-xl border border-farm-gold/40 bg-farm-gold/5 p-6 text-center">
        <p class="font-semibold text-farm-green-deep dark:text-farm-cream">Verified release measurements are pending</p>
        <p class="mt-2 text-sm text-farm-text-muted dark:text-farm-text-light-muted">The old Python-only and in-process figures were removed instead of being presented as current cross-language results.</p>
      </div>
    )}

    <div class="mt-8 text-center">
      <a href="/benchmarks" class="inline-flex items-center gap-1 text-sm font-medium text-farm-gold hover:text-farm-gold-light transition-colors">Methodology and release pins &rarr;</a>
    </div>
  </div>
</section>
