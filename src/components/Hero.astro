---
import RpcIllustration from './RpcIllustration.astro';
const languages = [
  { name: 'Python', url: 'https://vgi-rpc-python.query.farm', logo: 'python' },
  { name: 'TypeScript', url: 'https://vgi-rpc-typescript.query.farm', logo: 'typescript' },
  { name: 'Go', url: 'https://vgi-rpc-go.query.farm', logo: 'go' },
  { name: 'Rust', url: 'https://docs.rs/vgi-rpc', logo: 'rust' },
  { name: 'Java', url: 'https://javadoc.io/doc/farm.query/vgirpc', logo: 'java' },
  { name: 'C#', url: 'https://github.com/Query-farm/vgi-rpc-csharp#readme', logo: 'csharp' },
  { name: 'C++', url: 'https://vgi-rpc-cpp.query.farm', logo: 'cpp' },
];
---

<section class="rpc-hero">
  <div class="hero-layout">
    <div class="hero-copy">
      <p class="edition-label"><span class="font-mono">vgi-rpc</span><span class="edition-rule"></span>From Query.Farm</p>
      <h1 class="hero-heading-rpc">Arrow-native RPC.<br /><span>From subprocess<br /><em>to service.</em></span></h1>
      <p class="hero-description">Define services in code. Exchange <a class="qf-link" href="https://arrow.apache.org/" target="_blank" rel="noopener noreferrer">Apache Arrow</a> record batches across languages over subprocesses, sockets, or HTTP. Call your HTTP service directly from the browser.</p>
      <div class="hero-actions">
        <a class="start-link" href="#get-started">Start building <span aria-hidden="true">↗</span></a>
        <a class="qf-link" href="/wire-protocol">Explore the protocol <span aria-hidden="true">→</span></a>
      </div>
      <p class="hero-built-with">At the core of <a href="#built-with">VGI and Grainlift <span aria-hidden="true">↓</span></a></p>
    </div>
    <figure class="hero-plate">
      <RpcIllustration variant="hero" />
      <figcaption><span>Different routes. The same wire protocol.</span><span aria-hidden="true">↗</span></figcaption>
    </figure>
  </div>
  <div class="hero-languages">
    <p>Seven languages.<br /><span>Common ground.</span></p>
    <div>{languages.map(lang => <a href={lang.url} target="_blank" rel="noopener noreferrer"><img src={`/logos/${lang.logo}.svg`} alt="" class:list={[(lang.name === 'Rust' || lang.name === 'Java') && 'dark:invert']} />{lang.name}<span aria-hidden="true">↗</span></a>)}</div>
  </div>
</section>
