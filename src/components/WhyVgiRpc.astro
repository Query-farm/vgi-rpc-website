---


const features = [
  {
    title: 'Services defined in code',
    description: 'Define methods with native types or explicit Arrow schemas, depending on your SDK. There is no separate .proto service definition to maintain.',
  },
  {
    title: 'Transport-Agnostic',
    description: 'Built-in transports run from in-process pipes to authenticated Iroh/QUIC across a network, and the transport layer accepts custom implementations.',
  },
  {
    title: 'Apache Arrow Native',
    description: 'Arguments and results travel as Arrow record batches. Large DataFrames cross without row-by-row conversion, and the shared-memory side channel skips the copy entirely.',
  },
  {
    title: 'Streaming Built-in',
    description: 'Producer streams push batches from the server, and exchange streams trade them in lockstep with the client. Either kind can send a typed header before the data.',
  },
  {
    title: 'Direct from the browser',
    description: 'The TypeScript HTTP client uses browser fetch to send Arrow IPC directly to your service. Cross-origin deployments need CORS configuration; a gRPC-Web proxy is not required.',
  },
  {
    title: 'Runtime Reflection',
    description: 'Servers host several protocols side by side. vgi_rpc.Reflection.v1 lists them and describes any one — method kinds, Arrow schemas, and a protocol hash all seven ports compute identically.',
  },
];
---

<section id="why" class="py-20 md:py-24 bg-soil-100 dark:bg-rock-950/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl md:text-4xl text-center
      text-soil-900 dark:text-cream">
      Built for the work between services.
    </h2>
    <p class="mt-3 text-center text-lg text-soil-700 dark:text-cream-2 max-w-2xl mx-auto">
      Typed RPC across seven languages on one Arrow-based wire protocol.
    </p>

    <div class="mt-12 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {features.map((feature, index) => (
        <div class="feature-entry p-6 rounded-xl border shadow-sm
          bg-white border-soil-300/60
          dark:bg-rock-800 dark:border-rock-700 dark:shadow-none">
          <span class="feature-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <h3 class="text-lg text-soil-900 dark:text-cream">
            {feature.title}
          </h3>
          <p class="mt-2 text-sm text-soil-700 dark:text-cream-2 leading-relaxed">
            {feature.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
