---
import icons from '../data/transport-icons.json';

interface Props {
  /** A key in transport-icons.json. */
  transport?: keyof typeof icons;
  /** Inner SVG markup for a 24×24 duotone glyph, when not a transport. */
  body?: string;
  class?: string;
}

const { transport, body, class: className = '' } = Astro.props;
const markup = body ?? (transport ? icons[transport] : '');
---

<span class:list={[
  'transport-icon flex-shrink-0 inline-flex items-center justify-center w-14 h-14 rounded-xl border',
  'bg-soil-100 border-soil-300/70 text-field-700',
  'dark:bg-rock-800 dark:border-rock-700 dark:text-field-400',
  className,
]}>
  <svg
    viewBox="0 0 24 24"
    class="w-9 h-9"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    set:html={markup}
  />
</span>

<style is:global>
  /* Gold is identity: the one moving part of each glyph takes a mark band. */
  .transport-icon .accent {
    color: var(--color-sun-600);
  }
  @media (prefers-color-scheme: dark) {
    .transport-icon .accent {
      color: var(--color-sun-400);
    }
  }
</style>
