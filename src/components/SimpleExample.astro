---

<section id="example" class="py-20 md:py-24 bg-soil-50 dark:bg-rock-900">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="text-3xl md:text-4xl text-center
      text-soil-900 dark:text-cream">
      A Service in Three Files
    </h2>
    <p class="mt-3 text-center text-lg text-soil-700 dark:text-cream-2 max-w-2xl mx-auto">
      An interface, a worker that implements it, and a client that calls it over a subprocess or HTTP.
    </p>

    <div class="mt-10 space-y-4">
      <!-- Protocol: protocol.py -->
      <div class="rounded-xl overflow-hidden border border-rock-800 bg-rock-900 shadow-sm dark:border-rock-700">
        <div class="flex items-center gap-2 border-b border-rock-800 bg-rock-950 px-4 py-2 text-[13px] font-medium text-cream-2">
          <img src="/logos/python.svg" alt="Python" class="w-4 h-4" />
          <span class="font-mono text-cream">protocol.py</span><span aria-hidden="true" class="text-rock-700">·</span>define the interface
        </div>
        <pre class="qf-code p-5 overflow-x-auto text-base leading-relaxed"><code><span class="tk-kw">from</span> typing <span class="tk-kw">import</span> Protocol

<span class="tk-kw">class</span> <span class="tk-fn">Calculator</span>(Protocol):
    <span class="tk-kw">def</span> <span class="tk-fn">add</span>(self, a: <span class="tk-type">float</span>, b: <span class="tk-type">float</span>) -> <span class="tk-type">float</span>: ...
    <span class="tk-kw">def</span> <span class="tk-fn">greet</span>(self, name: <span class="tk-type">str</span>) -> <span class="tk-type">str</span>: ...</code></pre>
      </div>

      <!-- Server: worker.py -->
      <div class="rounded-xl overflow-hidden border border-rock-800 bg-rock-900 shadow-sm dark:border-rock-700">
        <div class="flex items-center gap-2 border-b border-rock-800 bg-rock-950 px-4 py-2 text-[13px] font-medium text-cream-2">
          <img src="/logos/python.svg" alt="Python" class="w-4 h-4" />
          <span class="font-mono text-cream">worker.py</span><span aria-hidden="true" class="text-rock-700">·</span>implement and serve
        </div>
        <pre class="qf-code p-5 overflow-x-auto text-base leading-relaxed"><code><span class="tk-kw">from</span> protocol <span class="tk-kw">import</span> Calculator
<span class="tk-kw">from</span> vgi_rpc <span class="tk-kw">import</span> run_server

<span class="tk-kw">class</span> <span class="tk-fn">CalculatorImpl</span>:
    <span class="tk-kw">def</span> <span class="tk-fn">add</span>(self, a: <span class="tk-type">float</span>, b: <span class="tk-type">float</span>) -> <span class="tk-type">float</span>:
        <span class="tk-kw">return</span> a + b
    <span class="tk-kw">def</span> <span class="tk-fn">greet</span>(self, name: <span class="tk-type">str</span>) -> <span class="tk-type">str</span>:
        <span class="tk-kw">return</span> <span class="tk-str">f"Hello, {'{'}name{'}'}!"</span>

run_server(Calculator, CalculatorImpl())</code></pre>
      </div>

      <!-- Client: client.py -->
      <div class="rounded-xl overflow-hidden border border-rock-800 bg-rock-900 shadow-sm dark:border-rock-700">
        <div class="flex items-center gap-2 border-b border-rock-800 bg-rock-950 px-4 py-2 text-[13px] font-medium text-cream-2">
          <img src="/logos/python.svg" alt="Python" class="w-4 h-4" />
          <span class="font-mono text-cream">client.py</span><span aria-hidden="true" class="text-rock-700">·</span>connect over subprocess or HTTP
        </div>
        <pre class="qf-code p-5 overflow-x-auto text-base leading-relaxed"><code><span class="tk-kw">from</span> protocol <span class="tk-kw">import</span> Calculator
<span class="tk-kw">from</span> vgi_rpc <span class="tk-kw">import</span> connect

<span class="tk-com"># Subprocess — launches worker.py automatically</span>
<span class="tk-kw">with</span> connect(Calculator, [<span class="tk-str">"python"</span>, <span class="tk-str">"worker.py"</span>]) <span class="tk-kw">as</span> calc:
    print(calc.add(a=<span class="tk-num">2.0</span>, b=<span class="tk-num">3.0</span>))    <span class="tk-com"># 5.0</span>
    print(calc.greet(name=<span class="tk-str">"World"</span>))  <span class="tk-com"># Hello, World!</span>

<span class="tk-com"># HTTP — connect to a running server</span>
<span class="tk-kw">with</span> connect(Calculator, <span class="tk-str">"https://localhost:8000"</span>) <span class="tk-kw">as</span> calc:
    print(calc.add(a=<span class="tk-num">2.0</span>, b=<span class="tk-num">3.0</span>))    <span class="tk-com"># 5.0</span></code></pre>
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* Strata Sun syntax theme (query-farm-astro CodeBlock .farm-theme). Ground is rock-900, always. */
  .qf-code { background: #1a1512; color: #e9e1d3; tab-size: 4; }
  .qf-code code { background: transparent; color: inherit; }
  .qf-code .tk-kw { color: #d9a441; font-weight: 600; }
  .qf-code .tk-str, .qf-code .tk-type { color: #9fc48c; }
  .qf-code .tk-fn { color: #d3a6e0; }
  .qf-code .tk-num { color: #8fc7d8; }
  .qf-code .tk-com { color: #8b8073; font-style: italic; }
</style>
