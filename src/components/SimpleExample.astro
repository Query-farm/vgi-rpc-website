---
import { Code } from 'astro:components';
import { farmTheme } from '../lib/farm-shiki-theme.mjs';
import examples from '../data/examples.json';
import RpcIllustration from './RpcIllustration.astro';
---

<section id="example" class="py-20 md:py-24 bg-soil-50 dark:bg-rock-900">
  <div class="example-layout max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="example-intro">
      <h2 class="text-3xl md:text-4xl text-soil-900 dark:text-cream">Define. Serve.<br /><em>Call.</em></h2>
      <p class="text-soil-700 dark:text-cream-2">The same addition, in your language. Define a method, run a worker, and make your first RPC.</p>
      <RpcIllustration variant="exchange" class="example-illustration" />
    </div>
    <div class="example-browser">
      <div class="example-tabs" role="tablist" aria-label="Example language">
        {examples.map((example, index) => <button
          type="button" role="tab" id={`tab-${example.id}`}
          aria-controls={`example-${example.id}`} aria-selected={index === 0 ? 'true' : 'false'}
          tabindex={index === 0 ? 0 : -1} data-language={example.id}
        ><img src={`/logos/${example.id}.svg`} alt="" class:list={[(example.id === 'rust' || example.id === 'java') && 'dark:invert']} />{example.name}</button>)}
      </div>
      {examples.map((example, index) => <div
        id={`example-${example.id}`} role="tabpanel" aria-labelledby={`tab-${example.id}`}
        hidden={index !== 0} tabindex="0" class="example-panel"
      >
        <div class="example-files">
          {example.files.map((file, fileIndex) => <div class="example-file">
            <div class="example-file-heading">
              <span class="example-step" aria-hidden="true">{String(fileIndex + 1).padStart(2, '0')}</span>
              <span class="example-filename">{file.name}</span>
              <span class="example-caption">{file.caption}</span>
            </div>
            <Code code={file.code} lang={example.syntax} theme={farmTheme} />
          </div>)}
        </div>
        <p class="example-setup">{example.note}</p>
        <a class="qf-link example-guide" href={example.docs} target="_blank" rel="noopener noreferrer">{example.name} SDK guide <span aria-hidden="true">↗</span></a>
      </div>)}
      <noscript><p class="example-setup">Enable JavaScript to switch languages. The Python example is shown above; all seven SDK guides are linked in <a class="qf-link" href="#languages">Language Implementations</a>.</p></noscript>
    </div>
  </div>
</section>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.example-tabs [role="tab"]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.example-panel'));
  const selectLanguage = (tab: HTMLButtonElement, focus = false) => {
    tabs.forEach(item => {
      const selected = item === tab;
      item.setAttribute('aria-selected', String(selected));
      item.tabIndex = selected ? 0 : -1;
    });
    panels.forEach(panel => { panel.hidden = panel.id !== tab.getAttribute('aria-controls'); });
    if (focus) tab.focus();
  };
  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => selectLanguage(tab));
    tab.addEventListener('keydown', event => {
      let nextIndex: number;
      switch (event.key) {
        case 'ArrowRight': nextIndex = (index + 1) % tabs.length; break;
        case 'ArrowLeft': nextIndex = (index - 1 + tabs.length) % tabs.length; break;
        case 'Home': nextIndex = 0; break;
        case 'End': nextIndex = tabs.length - 1; break;
        default: return;
      }
      event.preventDefault();
      selectLanguage(tabs[nextIndex], true);
    });
  });
</script>
